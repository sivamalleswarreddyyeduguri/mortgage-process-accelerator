    @Test
    public void testSave_EscrowFound_ServiceAreaAlreadyExists() {
    	Escrow escrow = new Escrow();
    	escrow.setEscoId(1); 
    	escrow.setEscoName("Sample Escrow"); 
    	escrow.setAddress("123 Main St");     	escrow.setCity("CityName"); // Set city to "CityName" or any desired value
    	escrow.setState("StateName"); // Set state to "StateName" or any desired value
    	escrow.setZipcode("12345"); // Set zipcode to "12345" or any desired value
    	escrow.setPhone("123-456-7890"); // Set phone to "123-456-7890" or any desired value
    	escrow.setEmail("sample@example.com"); // Set email to "sample@example.com" or any desired value
    	escrow.setInEscrowAcNo("IN-12345"); // Set inEscrowAcNo to "IN-12345" or any desired value
    	escrow.setEsAcBankName("BankName"); // Set esAcBankName to "BankName" or any desired value
    	escrow.setEsProcessTime(5);
    	
        when(escrowRepository.findByEscoName(anyString())).thenReturn(Optional.of(escrow));

        // Mock the service area repository to return existing service areas
        List<EscrowServiceArea> existingServiceAreas = new ArrayList<>();
        existingServiceAreas.add(new EscrowServiceArea());
        when(serviceAreaRepository.findByCountyStateCityZipcode(anyString(), anyString(), anyString(), anyString(), anyInt()))
                .thenReturn(existingServiceAreas);

        // Create the test data
        EscrowSaveDto escrowSaveDto = new EscrowSaveDto();
        escrowSaveDto.setEscoName("ABCD");
        EscrowServiceAreaDto escrowServiceAreaDto = new EscrowServiceAreaDto("USA", "USA", "USA", "USA", null);
        escrowSaveDto.setServiceAreas(List.of(escrowServiceAreaDto));

        when(escrowRepository.findByEscoName(anyString())).thenReturn(Optional.of(escrow));
        
        assertThrows(EscrowServiceAreaAlreadyExistsException.class, () -> {
        	when(escrowRepository.findByEscoName(anyString())).thenReturn(Optional.of(escrow));
            serviceAreaService.save(escrowSaveDto);
        });

        // Verify that the escrow repository method was called
        verify(escrowRepository, times(1)).findByEscoName(anyString());
        
        // Verify that the service area repository method was called
        verify(serviceAreaRepository, times(1)).findByCountyStateCityZipcode(anyString(), anyString(), anyString(), anyString(), anyInt());
    }

    
    
    

