    @Test
    void testFindById_Positive() {
        int serviceAreaId = 1;
        EscrowServiceArea escrowServiceArea = new EscrowServiceArea();
        EscrowServiceAreaDto expectedDto = new EscrowServiceAreaDto();
        when(serviceAreaRepository.findById(serviceAreaId)).thenReturn(Optional.of(escrowServiceArea));
        when(serviceAreaMapper.toDto(escrowServiceArea)).thenReturn(expectedDto);
        EscrowServiceAreaDto actualDto = serviceAreaService.findById(serviceAreaId);
        assertEquals(expectedDto, actualDto);
    }

    @Test
    void testFindById_Negative() {
        int invalidServiceAreaId = 100;
        when(serviceAreaRepository.findById(invalidServiceAreaId)).thenReturn(Optional.empty());

        ResourceNotFoundException exception = assertThrows(ResourceNotFoundException.class, () -> {
            serviceAreaService.findById(invalidServiceAreaId);
        });

        String expectedMessage = EscrowServiceAreaConstants.ESCROW_SERVICE_AREA_NOT_FOUND + invalidServiceAreaId;
        assertEquals(expectedMessage, exception.getMessage());
    }

   
