@SpringBootTest
class EscrowServiceAreaServiceImplTest {

	
    @Mock
    private EscrowServiceAreaMapper serviceAreaMapper;

    @Mock
    private EscrowServiceAreaRepository serviceAreaRepository;

    @Mock
    private EscrowRepository escrowRepository;

    @InjectMocks
    private EscrowServiceAreaServiceImpl serviceAreaService;


    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    
    
    
    @Test
    void testSave_Positive() {
        EscrowSaveDto saveDto = new EscrowSaveDto();
        saveDto.setEscoName("Existing Escrow");
        List<EscrowServiceAreaDto> serviceAreas = new ArrayList<>();
        EscrowServiceAreaDto serviceAreaDto = new EscrowServiceAreaDto();
        serviceAreaDto.setCounty("Los Angeles");
        serviceAreaDto.setCity("Los Angeles");
        serviceAreaDto.setState("California");
        serviceAreaDto.setZipcode("90001");
        serviceAreas.add(serviceAreaDto);
        saveDto.setServiceAreas(serviceAreas);
        
        Escrow escrow = new Escrow();
        escrow.setEscoId(1);
        when(escrowRepository.findByEscoName("Existing Escrow")).thenReturn(Optional.of(escrow));
        when(serviceAreaRepository.findByCountyStateCityZipcode(anyString(), anyString(), anyString(), anyString(), anyInt())).thenReturn(new ArrayList<>());
        assertDoesNotThrow(() -> serviceAreaService.save(saveDto));
    }
    
    
    
    
   

    @Test
    public void testSave_EscrowNotFound() {
    	 Escrow escrow = new Escrow();
         when(escrowRepository.findByEscoName(anyString())).thenReturn(Optional.of(escrow));

         // Mock the behavior of serviceAreaRepository to return existing service areas
         List<EscrowServiceArea> existingServiceAreas = new ArrayList<>();
         existingServiceAreas.add(new EscrowServiceArea());
         when(serviceAreaRepository.findByCountyStateCityZipcode(anyString(), anyString(), anyString(), anyString(), anyInt()))
                 .thenReturn(existingServiceAreas);

         // Call the method under test
         assertThrows(EscrowServiceAreaAlreadyExistsException.class, () -> {
        	 serviceAreaService.save(new EscrowSaveDto());
         });

         // Optionally, you can verify that the expected methods were called
         verify(escrowRepository, times(1)).findByEscoName(anyString());
         verify(serviceAreaRepository, times(1)).findByCountyStateCityZipcode(anyString(), anyString(), anyString(), anyString(), anyInt());
     }
    
    
    
    

    @Test
    @Disabled
    void save_ResourceNotFoundException() {
       
        EscrowSaveDto saveDto = new EscrowSaveDto();
        saveDto.setEscoName("Nonexistent Escrow");

        ResourceNotFoundException exception = assertThrows(ResourceNotFoundException.class, () -> serviceAreaService.save(saveDto));
        assertEquals("Escrow not found with name: NONEXISTENT ESCROW", exception.getMessage());
    }
    
    
    @Test
    void testFindById_Positive() {
        int serviceAreaId = 1;
        EscrowServiceArea escrowServiceArea = new EscrowServiceArea();
        EscrowServiceAreaDto expectedDto = new EscrowServiceAreaDto();
        when(serviceAreaRepository.findById(serviceAreaId)).thenReturn(Optional.of(escrowServiceArea));
        when(serviceAreaMapper.toDto(escrowServiceArea)).thenReturn(expectedDto);
        EscrowServiceAreaDto actualDto = serviceAreaService.findById(serviceAreaId);
        assertEquals(expectedDto, actualDto);
    }

    @Test
    void testFindById_Negative() {
        int invalidServiceAreaId = 100;
        when(serviceAreaRepository.findById(invalidServiceAreaId)).thenReturn(Optional.empty());

        ResourceNotFoundException exception = assertThrows(ResourceNotFoundException.class, () -> {
            serviceAreaService.findById(invalidServiceAreaId);
        });

        String expectedMessage = EscrowServiceAreaConstants.ESCROW_SERVICE_AREA_NOT_FOUND + invalidServiceAreaId;
        assertEquals(expectedMessage, exception.getMessage());
    }

   
