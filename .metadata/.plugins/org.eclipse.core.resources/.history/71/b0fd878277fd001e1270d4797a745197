   // success
    @Test
    void testUpdate_Success() {
        EscrowServiceAreaDto serviceAreaDto = new EscrowServiceAreaDto();
        serviceAreaDto.setCounty("Los Angeles");
        serviceAreaDto.setCity("Los Angeles");
        serviceAreaDto.setState("California");
        serviceAreaDto.setZipcode("90001");

        EscrowServiceArea escrowServiceArea = new EscrowServiceArea();
        escrowServiceArea.setCity("los angeles");
        escrowServiceArea.setState("los angeles");
        escrowServiceArea.setCounty("los angeles");
        escrowServiceArea.setServiceAreaId(10); // Set the ID here
        when(serviceAreaRepository.findById(10)).thenReturn(Optional.of(escrowServiceArea));
        when(serviceAreaMapper.toEntity(any())).thenReturn(escrowServiceArea); // Mock the mapper
        boolean result = serviceAreaService.update(serviceAreaDto, 10);
        assertTrue(result);
    }
    
    
    //success
    @Test
