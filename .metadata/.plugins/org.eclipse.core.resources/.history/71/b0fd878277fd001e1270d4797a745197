        serviceAreas.add(new EscrowServiceArea());
        when(serviceAreaRepository.findAll()).thenReturn(serviceAreas);

        assertNotNull(serviceAreaService.getAll());
    }
    
    
    // success
    @Test
    void testFindByEscrowName_Success() {
